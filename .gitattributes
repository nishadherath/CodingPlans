# Text files use LF in the index and in the working tree, on every platform.
# Reason: the bundles (dist/ and skill/**/scripts/hd.mjs) are generated and must be
# byte-reproducible from `npm run build:dist`. CRLF would make a local build differ
# from the committed output, and `npm run check:bundles` would fail.
* text=auto eol=lf

# The generated bundles stay LF (explicit, in case the rule above changes).
dist/*.mjs text eol=lf
skill/**/scripts/*.mjs text eol=lf

*.sh text eol=lf
